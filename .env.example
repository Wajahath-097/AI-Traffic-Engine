# Environment Variables Template
# Copy this to .env and fill in actual values

# ============= Backend =============
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# ============= Database =============
DATABASE_URL=postgresql://traffic_user:traffic_pass@localhost:5432/traffic_ai
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=traffic_pass
POSTGRES_DB=traffic_ai

# ============= Security =============
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
PASSWORD_MIN_LENGTH=8

# ============= CORS =============
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ============= Kafka =============
KAFKA_BROKER_URL=kafka:9092
KAFKA_TOPIC_PREFIX=traffic

# ============= Camera Configuration =============
CAMERA_CONFIG_PATH=/app/config/cameras.json
MAX_CAMERAS=10
FRAME_SAMPLE_RATE=5
INFERENCE_FPS=5

# ============= AI Models =============
YOLO_MODEL=yolov8m
YOLO_CONFIDENCE_THRESHOLD=0.5
OCR_ENGINE=paddleocr
OCR_LANGUAGE=en
OCR_CONFIDENCE_THRESHOLD=0.3
OCR_RECHECK_THRESHOLD=0.5

# ============= Media Gateway =============
MEDIA_GATEWAY_URL=http://mediamtx:8554
MEDIA_GATEWAY_PORT=8554
RTSP_TIMEOUT_SECONDS=30

# ============= Logging =============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============= File Storage =============
EVIDENCE_STORAGE_PATH=/data/evidence
TEMP_FRAME_PATH=/tmp/frames

# ============= Frontend =============
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============= Audit & Security =============
AUDIT_LOG_RETENTION_DAYS=90
DATA_RETENTION_DAYS=365
ENABLE_AUDIT_LOGGING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
